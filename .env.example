# Copy to .env. Sprint 1 reads only these.
HUKM_DATABASE_URL=sqlite:///./hukm_karo.db
# Postgres later: postgresql+psycopg://user:password@localhost:5432/hukm_karo
HUKM_MENU_PATH=data/menu.json
# Not confirmed by the restaurant yet. Keep 0 until it is.
HUKM_DELIVERY_FEE=0

# Exact pin of the restaurant (right-click the spot in Google Maps and copy the two numbers).
HUKM_RESTAURANT_LAT=
HUKM_RESTAURANT_LON=
HUKM_RESTAURANT_PIN_VERIFIED=false
HUKM_DELIVERY_RADIUS_M=3000
HUKM_GEOAPIFY_API_KEY=
HUKM_GROQ_API_KEY=
HUKM_GEMINI_API_KEY=
