# Copy this file to .env.local and fill in the two Vapi values.
# Both come from .env.hukm in the project root:
#   NEXT_PUBLIC_VAPI_PUBLIC_KEY  = the value of HUKM_VAPI_API_KEY (Vapi's client key, pub_...)
#   NEXT_PUBLIC_VAPI_ASSISTANT_ID = the value of HUKM_VAPI_ASSISTANT_ID
# The speech pipeline (STT, LLM, TTS) then runs on the Vapi assistant. Without
# these two lines the voice demo falls back to in-browser speech and the local engine.

NEXT_PUBLIC_VAPI_PUBLIC_KEY=pub_put_the_public_key_here
NEXT_PUBLIC_VAPI_ASSISTANT_ID=put_the_assistant_id_here
NEXT_PUBLIC_API_URL=http://localhost:8000